{
  "openapi": "3.1.0",
  "info": {
    "title": "Saltcorn Go — API interna (BFF → Go)",
    "version": "0.1.0",
    "description": "Contrato consumido pelo BFF Node.js (ADR-0003) — nunca diretamente pelo navegador — e, em versões futuras, por integrações externas autorizadas via API pública própria. Cobre o exemplo de CQRS de registros dinâmicos definido em ADR-0001 (`CreateRecord`/`ListRecords`) como recorte inicial representativo: não é a superfície completa do domínio, que ainda não existe em Go (ver docs/migracao-go/execucoes/GO-006.md, nota de escopo).\n"
  },
  "servers": [
    {
      "url": "http://localhost:8090",
      "description": "cmd/server local (GO-005)"
    }
  ],
  "security": [
    {
      "ServiceIdentity": []
    }
  ],
  "paths": {
    "/healthz": {
      "get": {
        "operationId": "getLiveness",
        "summary": "Liveness (GO-005)",
        "security": [],
        "responses": {
          "200": {
            "description": "processo vivo"
          }
        }
      }
    },
    "/readyz": {
      "get": {
        "operationId": "getReadiness",
        "summary": "Readiness (GO-005)",
        "security": [],
        "responses": {
          "200": {
            "description": "pronto para tráfego"
          },
          "503": {
            "description": "ainda não pronto"
          }
        }
      }
    },
    "/v1/tenants/{tenant}/actor": {
      "parameters": [
        {
          "name": "tenant",
          "in": "path",
          "required": true,
          "schema": {
            "$ref": "#/components/schemas/Tenant"
          }
        }
      ],
      "get": {
        "operationId": "getActor",
        "summary": "Query: papel atual do ator da identidade delegada",
        "description": "Adicionado por GO-017 para o BFF resolver papel/permissões atuais a cada requisição (ADR-0007) em vez de confiar num valor cacheado na sessão de navegador — uma mudança de papel ou revogação de acesso vale a partir desta consulta, nunca de um valor antigo guardado alhures. `id`/`role_id` são resolvidos do `sub` do token, não de parâmetro algum — não é possível consultar o ator de outra pessoa.\n",
        "responses": {
          "200": {
            "description": "papel atual do ator autenticado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Actor"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          }
        }
      }
    },
    "/v1/tenants/{tenant}/tables/{table}/records": {
      "parameters": [
        {
          "name": "tenant",
          "in": "path",
          "required": true,
          "schema": {
            "$ref": "#/components/schemas/Tenant"
          }
        },
        {
          "name": "table",
          "in": "path",
          "required": true,
          "description": "Nome da tabela dinâmica (definida em tempo de execução pelo usuário final — GO-011).",
          "schema": {
            "type": "string"
          }
        }
      ],
      "get": {
        "operationId": "listRecords",
        "summary": "Query: lista registros de uma tabela dinâmica",
        "description": "Aplica as mesmas políticas de visibilidade (papel, ownership, RLS) que os comandos de escrita — ADR-0001. Não executa ações de negócio.\n",
        "parameters": [
          {
            "$ref": "#/components/parameters/Cursor"
          },
          {
            "$ref": "#/components/parameters/Limit"
          }
        ],
        "responses": {
          "200": {
            "description": "página de registros",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/Page"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "items": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/Record"
                          }
                        }
                      }
                    }
                  ]
                },
                "examples": {
                  "positivo_identidade_valida": {
                    "summary": "Positivo: identidade delegada válida, tenant confere",
                    "value": {
                      "items": [
                        {
                          "id": 1,
                          "version": 1,
                          "created_at": "2026-01-15T00:00:00Z",
                          "updated_at": "2026-01-15T00:00:00Z",
                          "name": "guitars"
                        }
                      ],
                      "next_cursor": null
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          }
        }
      },
      "post": {
        "operationId": "createRecord",
        "summary": "Command: cria um registro",
        "description": "Valida tenant, ator, schema, tipos, ownership e triggers transacionais; grava o registro e o outbox na mesma transação (ADR-0001). Idempotente por Idempotency-Key.\n",
        "parameters": [
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RecordInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "registro criado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Record"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "409": {
            "$ref": "#/components/responses/IdempotencyConflict"
          }
        }
      }
    },
    "/v1/tenants/{tenant}/tables/{table}/records/{id}": {
      "parameters": [
        {
          "name": "tenant",
          "in": "path",
          "required": true,
          "schema": {
            "$ref": "#/components/schemas/Tenant"
          }
        },
        {
          "name": "table",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "$ref": "#/components/schemas/Id"
          }
        }
      ],
      "get": {
        "operationId": "getRecord",
        "summary": "Query: busca um registro por ID",
        "responses": {
          "200": {
            "description": "registro encontrado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Record"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "description": "registro não encontrado (ou fora da visibilidade do ator — nunca distingue os dois casos na resposta)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "patch": {
        "operationId": "updateRecord",
        "summary": "Command: atualiza campos de um registro",
        "description": "Semântica de JSON Merge Patch (RFC 7396): campo ausente do corpo = sem alteração; campo presente com valor `null` = limpar o campo. Falha de versão otimista retorna 409.\n",
        "parameters": [
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/merge-patch+json": {
              "schema": {
                "type": "object",
                "additionalProperties": true
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "registro atualizado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Record"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "409": {
            "description": "conflito de versão otimista ou de idempotência",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "delete": {
        "operationId": "deleteRecord",
        "summary": "Command: remove um registro",
        "parameters": [
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "responses": {
          "204": {
            "description": "removido"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "description": "já não existia (delete é idempotente)"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ServiceIdentity": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Identidade delegada ator+tenant entre BFF e backend Go (ADR-0003). O BFF assina um JWT de vida curta com claims `{sub (ator), tenant, iat, exp}`; o Go valida assinatura, expiração, e que o claim `tenant` bate com o tenant da URL (ver schema Tenant em common.yaml). Nunca aceitar tenant vindo de um header solto — GO-001 §2.1, \"identidade não pode ser forjada por headers\". Exemplos completos (positivo e dois negativos) em ../fixtures/identidade-delegada.md.\n"
      }
    },
    "schemas": {
      "Actor": {
        "type": "object",
        "required": [
          "id",
          "role_id"
        ],
        "properties": {
          "id": {
            "$ref": "#/components/schemas/Id"
          },
          "role_id": {
            "type": "integer",
            "description": "Papel atual do ator (identity.RoleID) — nunca cacheado pelo chamador, sempre resolvido nesta consulta."
          }
        }
      },
      "RecordInput": {
        "type": "object",
        "additionalProperties": true,
        "description": "Campos do registro conforme o schema dinâmico da tabela (GO-011). Este contrato não pode enumerar campos fixos — validação de schema acontece no backend, não aqui.\n"
      },
      "Record": {
        "type": "object",
        "required": [
          "id",
          "version",
          "created_at"
        ],
        "properties": {
          "id": {
            "$ref": "#/components/schemas/Id"
          },
          "version": {
            "type": "integer",
            "description": "Versão otimista do registro (ADR-0001) — usada para detectar escrita concorrente."
          },
          "created_at": {
            "$ref": "#/components/schemas/DateTime"
          },
          "updated_at": {
            "$ref": "#/components/schemas/DateTime"
          }
        },
        "additionalProperties": true
      },
      "Tenant": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]{0,62}$",
        "description": "Identificador de tenant. O BFF resolve o tenant por mapeamento confiável (host/subdomínio) e o inclui explicitamente na URL das chamadas ao backend Go — nunca é aceito de um header arbitrário do cliente final. Isso não basta sozinho: o backend Go valida independentemente que o claim `tenant` da identidade delegada (ver ServiceIdentity em internal-api.yaml) bate com este valor da URL, rejeitando com 403 (tenant_mismatch) quando não bater — defesa em profundidade, não confiança cega na URL.\n"
      },
      "Id": {
        "type": "integer",
        "format": "int64",
        "description": "Identificador de registro. Limitação explícita desta versão do contrato: assume chave primária inteira simples — chaves compostas (risco já sinalizado na matriz de capacidades GO-001) ficam fora de escopo até uma revisão dedicada do contrato.\n"
      },
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string",
                "description": "Código estável para tratamento programático (ex.: \"invalid_identity_token\")."
              },
              "message": {
                "type": "string",
                "description": "Mensagem legível; não é garantida estável entre versões do contrato."
              },
              "details": {
                "type": "object",
                "additionalProperties": true,
                "description": "Contexto adicional opcional (ex.: qual campo era inválido)."
              }
            }
          }
        }
      },
      "Page": {
        "type": "object",
        "required": [
          "items",
          "next_cursor"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {}
          },
          "next_cursor": {
            "type": [
              "string",
              "null"
            ],
            "description": "Cursor para a próxima página, ou `null` se não houver mais páginas."
          }
        }
      },
      "DateTime": {
        "type": "string",
        "format": "date-time",
        "description": "Sempre UTC explícito (sufixo Z), nunca hora local implícita. Mitiga a classe de bug encontrada em GO-002 (2 falsos positivos de teste causados pelo timezone do host não ser UTC) — ver docs/migracao-go/baseline/GO-002-baseline.md §2.\n",
        "example": "2026-01-15T00:00:00Z"
      }
    },
    "responses": {
      "Unauthorized": {
        "description": "Identidade ausente, expirada ou com assinatura inválida.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "examples": {
              "invalid_signature": {
                "summary": "Negativo: token com assinatura inválida",
                "value": {
                  "error": {
                    "code": "invalid_identity_token",
                    "message": "assinatura do token de identidade delegada não confere"
                  }
                }
              }
            }
          }
        }
      },
      "Forbidden": {
        "description": "Identidade válida, mas sem permissão para o recurso pedido.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "examples": {
              "tenant_mismatch": {
                "summary": "Negativo: tenant do token não bate com o tenant da URL",
                "value": {
                  "error": {
                    "code": "tenant_mismatch",
                    "message": "tenant do token de identidade não corresponde ao tenant do recurso"
                  }
                }
              }
            }
          }
        }
      },
      "IdempotencyConflict": {
        "description": "Mesma chave de idempotência usada com um payload diferente.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "examples": {
              "payload_mismatch": {
                "summary": "Negativo: chave de idempotência reaproveitada com payload diferente",
                "value": {
                  "error": {
                    "code": "idempotency_key_conflict",
                    "message": "Idempotency-Key já foi usada com um payload diferente"
                  }
                }
              }
            }
          }
        }
      }
    },
    "parameters": {
      "Cursor": {
        "name": "cursor",
        "in": "query",
        "required": false,
        "description": "Cursor opaco da página anterior. Omitir para a primeira página.",
        "schema": {
          "type": "string"
        }
      },
      "Limit": {
        "name": "limit",
        "in": "query",
        "required": false,
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200,
          "default": 50
        }
      },
      "IdempotencyKey": {
        "name": "Idempotency-Key",
        "in": "header",
        "required": true,
        "description": "Chave de idempotência escopada por tenant/ator/operação (ADR-0001). Requisições repetidas com a mesma chave e o mesmo payload retornam o resultado da primeira execução; a mesma chave com payload diferente é rejeitada com 409 (ver response IdempotencyConflict).\n",
        "schema": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        }
      }
    }
  }
}