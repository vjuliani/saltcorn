{
  "openapi": "3.1.0",
  "info": {
    "title": "Saltcorn Go — API do BFF (React → BFF)",
    "version": "0.1.0",
    "description": "Contrato consumido pelo frontend React (ADR-0002) através do BFF Node.js (ADR-0003). O BFF compõe estes recursos chamando internal-api.yaml do lado de trás; nunca acessa banco de domínio nem concentra regras de negócio. Mesmo recorte representativo de internal-api.yaml (registros dinâmicos) — ver nota de escopo em docs/migracao-go/execucoes/GO-006.md.\n"
  },
  "servers": [
    {
      "url": "http://localhost:3100",
      "description": "BFF Node.js local (a criar em GO-017)"
    }
  ],
  "security": [
    {
      "SessionCookie": [],
      "CsrfToken": []
    }
  ],
  "paths": {
    "/api/bff/operator-session": {
      "post": {
        "operationId": "exchangeOperatorTicket",
        "summary": "Abre sessão administrativa com ticket emitido pela CLI local",
        "description": "Opcional, habilitado somente no pacote self-hosted. Ticket HS256 com audience saltcorn-cli-login, issuer da instalação e prazo máximo de 60 segundos; uso único por processo. Revalida administrador no Go. Exige Content-Type JSON e Origin com o mesmo host da requisição. Não substitui autenticação de usuários finais nem aceita ServiceIdentity.\n",
        "security": [],
        "parameters": [
          {
            "name": "Origin",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "ticket"
                ],
                "properties": {
                  "ticket": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Sessão criada; cookies sc_session e sc_csrf emitidos",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "status"
                  ],
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "ok"
                      ]
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Ticket inválido, expirado, reutilizado ou administrador indisponível"
          },
          "403": {
            "description": "Origem ou tipo de conteúdo inválido"
          },
          "404": {
            "description": "Perfil self-hosted não habilitado"
          }
        }
      }
    },
    "/api/bff/sync/{table}/exchange": {
      "parameters": [
        {
          "name": "table",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "post": {
        "operationId": "exchangeOfflineSyncBff",
        "summary": "Sincroniza alterações offline com conflitos explícitos e snapshot autorizado",
        "description": "GO-031, protocolo 1, independente do sync legado. Mesma operação/ID é idempotente; reutilizar ID com outro conteúdo retorna 409. Scope deve corresponder à sessão/identidade autenticada. Erros HTTP revertem o lote. Conflitos de registro retornam resultados explícitos em 200.\n",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Request"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Resultados idempotentes e snapshot completo para persistência atômica local",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Response"
                }
              }
            }
          },
          "400": {
            "description": "Protocolo ou corpo inválido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Sessão ou identidade inválida",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Scope, papel ou CSRF inválido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Tabela indisponível",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Schema alterado ou ID reutilizado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "Corpo ou snapshot acima do limite",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "502": {
            "description": "Falha no domínio",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Serviço indisponível",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/bff/bootstrap": {
      "get": {
        "operationId": "getBootstrap",
        "summary": "Bootstrap do editor — metadados e permissões de interface (ADR-0003)",
        "security": [
          {
            "SessionCookie": []
          }
        ],
        "responses": {
          "200": {
            "description": "dados de bootstrap para a sessão atual",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Bootstrap"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/SessionRequired"
          }
        }
      }
    },
    "/api/bff/tables/{table}/records": {
      "parameters": [
        {
          "name": "table",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "get": {
        "operationId": "listRecords",
        "summary": "Lista registros (a UI não distingue papel/ownership — o backend Go já filtrou)",
        "security": [
          {
            "SessionCookie": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/Cursor"
          },
          {
            "$ref": "#/components/parameters/Limit"
          }
        ],
        "responses": {
          "200": {
            "description": "página de registros, mesmo formato de internal-api.yaml `Page`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Page"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/SessionRequired"
          },
          "502": {
            "$ref": "#/components/responses/DomainUnavailable"
          }
        }
      },
      "post": {
        "operationId": "createRecord",
        "summary": "Cria um registro",
        "description": "O BFF gera e propaga a Idempotency-Key para a chamada interna correspondente; um retry do navegador (ex.: timeout percebido pelo usuário) reaproveita a mesma chave, não gera uma nova (ADR-0003: \"retries de comandos exigem a mesma chave de idempotência\").\n",
        "security": [
          {
            "SessionCookie": [],
            "CsrfToken": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": true
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "registro criado",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/SessionRequired"
          },
          "403": {
            "$ref": "#/components/responses/CsrfInvalid"
          },
          "502": {
            "$ref": "#/components/responses/DomainUnavailable"
          }
        }
      }
    },
    "/api/bff/tables": {
      "post": {
        "operationId": "createTable",
        "summary": "Cria uma tabela dinâmica (GO-019)",
        "security": [
          {
            "SessionCookie": [],
            "CsrfToken": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "name"
                ],
                "properties": {
                  "name": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "tabela criada",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/SessionRequired"
          },
          "403": {
            "$ref": "#/components/responses/CsrfInvalid"
          },
          "502": {
            "$ref": "#/components/responses/DomainUnavailable"
          }
        }
      }
    },
    "/api/bff/tables/{table}/fields": {
      "parameters": [
        {
          "name": "table",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "post": {
        "operationId": "addField",
        "summary": "Adiciona um campo a uma tabela dinâmica (GO-019)",
        "security": [
          {
            "SessionCookie": [],
            "CsrfToken": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "name",
                  "type"
                ],
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "type": {
                    "type": "string"
                  },
                  "required": {
                    "type": "boolean"
                  },
                  "unique": {
                    "type": "boolean"
                  },
                  "references": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "campo criado",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/SessionRequired"
          },
          "403": {
            "$ref": "#/components/responses/CsrfInvalid"
          },
          "502": {
            "$ref": "#/components/responses/DomainUnavailable"
          }
        }
      }
    },
    "/api/bff/views": {
      "get": {
        "operationId": "listViews",
        "summary": "Lista views visíveis ao ator (GO-020)",
        "security": [
          {
            "SessionCookie": []
          }
        ],
        "parameters": [
          {
            "name": "table",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "views visíveis ao ator",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/View"
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/SessionRequired"
          },
          "502": {
            "$ref": "#/components/responses/DomainUnavailable"
          }
        }
      },
      "post": {
        "operationId": "createView",
        "summary": "Cria uma view — o documento de layout do editor (GO-019)",
        "description": "O BFF gera e propaga a Idempotency-Key para a chamada interna, mesmo padrão de createRecord — um retry do editor reaproveita a mesma chave.\n",
        "security": [
          {
            "SessionCookie": [],
            "CsrfToken": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "name",
                  "table",
                  "template",
                  "configuration"
                ],
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "table": {
                    "type": "string"
                  },
                  "template": {
                    "type": "string"
                  },
                  "configuration": {
                    "type": "object",
                    "additionalProperties": true
                  },
                  "min_role": {
                    "type": "integer"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "view criada",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/View"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/SessionRequired"
          },
          "403": {
            "$ref": "#/components/responses/CsrfInvalid"
          },
          "502": {
            "$ref": "#/components/responses/DomainUnavailable"
          }
        }
      }
    },
    "/api/bff/views/{id}": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "$ref": "#/components/schemas/Id"
          }
        }
      ],
      "get": {
        "operationId": "getView",
        "summary": "Reabre uma view (GO-019)",
        "security": [
          {
            "SessionCookie": []
          }
        ],
        "responses": {
          "200": {
            "description": "view encontrada",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/View"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/SessionRequired"
          },
          "404": {
            "description": "view não encontrada (ou fora da visibilidade do ator, nunca distingue os dois casos)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "502": {
            "$ref": "#/components/responses/DomainUnavailable"
          }
        }
      },
      "patch": {
        "operationId": "updateView",
        "summary": "Salva ou publica uma view (GO-019)",
        "description": "Mesma operação para \"salvar\" (corpo com `configuration`) e \"publicar\" (corpo com `min_role` menor). Exige `_version` (de uma leitura anterior) — conflito de edição concorrente retorna 409, nunca sobrescreve silenciosamente.\n",
        "security": [
          {
            "SessionCookie": [],
            "CsrfToken": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "_version"
                ],
                "properties": {
                  "_version": {
                    "type": "string"
                  },
                  "configuration": {
                    "type": "object",
                    "additionalProperties": true
                  },
                  "template": {
                    "type": "string"
                  },
                  "min_role": {
                    "type": "integer"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "view atualizada",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/View"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/SessionRequired"
          },
          "403": {
            "$ref": "#/components/responses/CsrfInvalid"
          },
          "409": {
            "description": "Negativo: conflito de edição concorrente — a view mudou desde a leitura",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "conflito_de_edicao": {
                    "summary": "Negativo: outra sessão salvou primeiro",
                    "value": {
                      "error": {
                        "code": "version_conflict",
                        "message": "a view foi modificada por outra transação — releia e tente novamente"
                      }
                    }
                  }
                }
              }
            }
          },
          "422": {
            "description": "Negativo: layout incompatível com o runtime — só ao tentar publicar (GO-020)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "layout_incompativel": {
                    "summary": "Negativo: template/colunas fora do subconjunto suportado",
                    "value": {
                      "error": {
                        "code": "view_unsupported",
                        "message": "template \"Show\" não suportado neste runtime (só \"List\")"
                      }
                    }
                  }
                }
              }
            }
          },
          "502": {
            "$ref": "#/components/responses/DomainUnavailable"
          }
        }
      }
    },
    "/api/bff/views/{id}/render": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "$ref": "#/components/schemas/Id"
          }
        }
      ],
      "get": {
        "operationId": "renderView",
        "summary": "Renderiza uma view List (GO-020)",
        "description": "Devolve o DTO (colunas + linhas + paginação) de internal-api.yaml, sem reinterpretar nada — o React desenha a tabela a partir dele.\n",
        "security": [
          {
            "SessionCookie": []
          }
        ],
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "plano de renderização",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ViewRenderPlan"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/SessionRequired"
          },
          "404": {
            "description": "view não encontrada (ou fora da visibilidade do ator)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "view existe, mas usa um recurso fora do subconjunto suportado por este runtime",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "502": {
            "$ref": "#/components/responses/DomainUnavailable"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "SessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "sc_session",
        "description": "Sessão de navegador, emitida e validada pelo BFF Node.js (ADR-0003). Nome e atributos do cookie fixados em ADR-0007 (HttpOnly, Secure, SameSite=Lax, 24h com renovação deslizante) — corrigido aqui de um nome de placeholder (`connect.sid`, padrão genérico de `express-session`) para o nome realmente decidido, GO-017 implementa exatamente este contrato. Nunca chega ao backend Go — o BFF troca a sessão por um token de ServiceIdentity (ver internal-api.yaml) antes de chamar o domínio.\n"
      },
      "CsrfToken": {
        "type": "apiKey",
        "in": "header",
        "name": "X-CSRF-Token",
        "description": "Exigido em toda requisição de mutação (POST/PATCH/DELETE) autenticada por sessão de navegador."
      }
    },
    "responses": {
      "SessionRequired": {
        "description": "Sem sessão de navegador válida.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "examples": {
              "sem_sessao": {
                "summary": "Negativo: sessão ausente/expirada",
                "value": {
                  "error": {
                    "code": "session_required",
                    "message": "sessão de navegador ausente ou expirada"
                  }
                }
              }
            }
          }
        }
      },
      "DomainUnavailable": {
        "description": "O backend Go não respondeu dentro do timeout, ou respondeu com erro de infraestrutura — a indisponibilidade do Go deve produzir um erro controlado na UI (ADR-0003), nunca travar a requisição indefinidamente.\n",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "examples": {
              "timeout": {
                "summary": "Negativo: backend Go indisponível/timeout",
                "value": {
                  "error": {
                    "code": "domain_unavailable",
                    "message": "não foi possível completar a operação — tente novamente"
                  }
                }
              }
            }
          }
        }
      },
      "CsrfInvalid": {
        "description": "Token CSRF ausente ou inválido.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "examples": {
              "csrf_invalido": {
                "summary": "Negativo: CSRF ausente/inválido",
                "value": {
                  "error": {
                    "code": "csrf_invalid",
                    "message": "token CSRF ausente ou inválido"
                  }
                }
              }
            }
          }
        }
      }
    },
    "schemas": {
      "Bootstrap": {
        "type": "object",
        "required": [
          "actor",
          "tenant"
        ],
        "properties": {
          "actor": {
            "type": "object",
            "properties": {
              "id": {
                "$ref": "#/components/schemas/Id"
              },
              "role_id": {
                "type": "integer"
              }
            }
          },
          "tenant": {
            "$ref": "#/components/schemas/Tenant"
          }
        }
      },
      "View": {
        "type": "object",
        "required": [
          "id",
          "name",
          "table_id",
          "template",
          "min_role",
          "configuration",
          "_version"
        ],
        "properties": {
          "id": {
            "$ref": "#/components/schemas/Id"
          },
          "name": {
            "type": "string"
          },
          "table_id": {
            "$ref": "#/components/schemas/Id"
          },
          "template": {
            "type": "string"
          },
          "min_role": {
            "type": "integer"
          },
          "configuration": {
            "type": "object",
            "additionalProperties": true
          },
          "_version": {
            "type": "string"
          }
        }
      },
      "ViewRenderColumn": {
        "type": "object",
        "required": [
          "field_name",
          "header_label"
        ],
        "properties": {
          "field_name": {
            "type": "string"
          },
          "header_label": {
            "type": "string"
          }
        }
      },
      "ViewRenderPlan": {
        "type": "object",
        "required": [
          "view_id",
          "columns",
          "rows",
          "order_by",
          "descending"
        ],
        "properties": {
          "view_id": {
            "$ref": "#/components/schemas/Id"
          },
          "columns": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ViewRenderColumn"
            }
          },
          "rows": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true
            }
          },
          "order_by": {
            "type": "string"
          },
          "descending": {
            "type": "boolean"
          },
          "next_cursor": {
            "type": [
              "string",
              "null"
            ],
            "description": "Cursor para a próxima página, ou `null` se não houver mais páginas."
          }
        }
      },
      "Scope": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "tenant",
          "actor",
          "table"
        ],
        "properties": {
          "tenant": {
            "type": "string",
            "minLength": 1
          },
          "actor": {
            "type": "string",
            "minLength": 1
          },
          "table": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "Mutation": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,128}$",
            "description": "Identificador imutável de uma tentativa. Resolver conflito exige novo ID."
          },
          "kind": {
            "type": "string",
            "enum": [
              "create",
              "update",
              "delete"
            ]
          },
          "row_id": {
            "type": "integer",
            "minimum": 1
          },
          "base_version": {
            "type": "string",
            "maxLength": 128,
            "description": "Obrigatório em update/delete; token recebido na leitura original."
          },
          "values": {
            "type": "object",
            "additionalProperties": true
          }
        }
      },
      "Request": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "protocol",
          "scope",
          "client_id",
          "schema_version",
          "checkpoint",
          "mutations"
        ],
        "properties": {
          "protocol": {
            "type": "integer",
            "const": 1
          },
          "scope": {
            "$ref": "#/components/schemas/Scope"
          },
          "client_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,128}$"
          },
          "schema_version": {
            "type": "integer",
            "minimum": 0
          },
          "checkpoint": {
            "type": "string",
            "maxLength": 128,
            "description": "Hash do último snapshot gravado localmente; vazio no bootstrap. Não é cursor incremental."
          },
          "mutations": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "$ref": "#/components/schemas/Mutation"
            }
          }
        }
      },
      "Result": {
        "type": "object",
        "required": [
          "id",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "applied",
              "conflict",
              "rejected"
            ]
          },
          "code": {
            "type": "string"
          },
          "row_id": {
            "type": "integer"
          }
        }
      },
      "Response": {
        "type": "object",
        "required": [
          "protocol",
          "scope",
          "schema_version",
          "fields",
          "checkpoint",
          "results",
          "rows"
        ],
        "properties": {
          "protocol": {
            "type": "integer",
            "const": 1
          },
          "scope": {
            "$ref": "#/components/schemas/Scope"
          },
          "schema_version": {
            "type": "integer",
            "minimum": 0
          },
          "fields": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "name",
                "type",
                "required"
              ],
              "properties": {
                "name": {
                  "type": "string"
                },
                "type": {
                  "type": "string",
                  "enum": [
                    "text",
                    "integer",
                    "boolean",
                    "float",
                    "date",
                    "key"
                  ]
                },
                "required": {
                  "type": "boolean"
                }
              }
            }
          },
          "checkpoint": {
            "type": "string"
          },
          "results": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Result"
            }
          },
          "rows": {
            "type": "array",
            "maxItems": 2000,
            "description": "Substituição completa e autorizada da tabela. Ausência representa exclusão ou perda de acesso; o cliente preserva rascunhos pendentes separadamente. Sem paginação parcial: se exceder 2000 linhas, toda a transação falha com 413.\n",
            "items": {
              "type": "object",
              "required": [
                "id",
                "_version"
              ],
              "properties": {
                "id": {
                  "type": "integer"
                },
                "_version": {
                  "type": "string"
                }
              },
              "additionalProperties": true
            }
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string",
                "description": "Código estável para tratamento programático (ex.: \"invalid_identity_token\")."
              },
              "message": {
                "type": "string",
                "description": "Mensagem legível; não é garantida estável entre versões do contrato."
              },
              "details": {
                "type": "object",
                "additionalProperties": true,
                "description": "Contexto adicional opcional (ex.: qual campo era inválido)."
              }
            }
          }
        }
      },
      "Id": {
        "type": "integer",
        "format": "int64",
        "description": "Identificador de registro. Limitação explícita desta versão do contrato: assume chave primária inteira simples — chaves compostas (risco já sinalizado na matriz de capacidades GO-001) ficam fora de escopo até uma revisão dedicada do contrato.\n"
      },
      "Tenant": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]{0,62}$",
        "description": "Identificador de tenant. O BFF resolve o tenant por mapeamento confiável (host/subdomínio) e o inclui explicitamente na URL das chamadas ao backend Go — nunca é aceito de um header arbitrário do cliente final. Isso não basta sozinho: o backend Go valida independentemente que o claim `tenant` da identidade delegada (ver ServiceIdentity em internal-api.yaml) bate com este valor da URL, rejeitando com 403 (tenant_mismatch) quando não bater — defesa em profundidade, não confiança cega na URL.\n"
      },
      "Page": {
        "type": "object",
        "required": [
          "items",
          "next_cursor"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {}
          },
          "next_cursor": {
            "type": [
              "string",
              "null"
            ],
            "description": "Cursor para a próxima página, ou `null` se não houver mais páginas."
          }
        }
      }
    },
    "parameters": {
      "Cursor": {
        "name": "cursor",
        "in": "query",
        "required": false,
        "description": "Cursor opaco da página anterior. Omitir para a primeira página.",
        "schema": {
          "type": "string"
        }
      },
      "Limit": {
        "name": "limit",
        "in": "query",
        "required": false,
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200,
          "default": 50
        }
      }
    }
  }
}